{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "font": "JetBrainsMono Nerd Font 12",
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 50,
  "modules-left": [
    "clock",
    "custom/weather",
    "custom/notification",
    "custom/events",
    "custom/pckg_update",
    "custom/vpn"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    //"network",
    "tray",
    "bluetooth",
    "custom/layout",
    "custom/power-profile",
    "battery",
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone"
  ],
  "custom/layout": {
    "exec": "~/.config/waybar/scripts/layout.sh",
    "signal": 6,
    "on-click": "hyprctl switchxkblayout 'xremap' next",
    "return-type": "json",
    "format": " {}"
  },
  "custom/power-profile": {
    "exec": "~/.config/waybar/scripts/powerprofile.sh",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/powerprofile_toggle.sh",
    "format": "{}"
  },
  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/getVpnServer.sh",
    "format": "{}",
    "interval": 5,
    "signal": 7,
    "on-click": "~/.config/waybar/scripts/toggleVPNconnect.sh",
    "class": "vpn",
    "return-type": "json",
    "markup": "pango"
  },
  "custom/pckg_update": {
    "exec": "~/.config/waybar/scripts/pckg_update.sh",
    "format": "{}",
    "interval": 500,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/update_pckg.sh",
    "return-type": "json"
  },
  "custom/events": {
    "format": "{}",
    "tooltip": true,
    "interval": 300,
    "format-icons": {
      "default": ""
    },
    "on-click": "vdirsyncer sync",
    "exec": "~/.config/waybar/scripts/waybar-khal.py",
    "return-type": "json",
    "markup": "pango"
  },
  "hyprland/window": {
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Chromium": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },
  // "custom/power_profile": {
  //   //shows the current power profile and switches to next on click
  //   "exec": "asusctl profile -p | sed s:'Active profile is'::",
  //   "interval": 30,
  //   "format": "󰈐{}",
  //   "on-click": "asusctl profile -n; pkill -SIGRTMIN+8 waybar",
  //   "signal": 8
  // },
  "custom/notification": {
    "tooltip": false,
    "format": "{} {icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/weather": {
    //shows the current weather and forecast
    "tooltip": true,
    "format": "{}",
    "interval": 30,
    "exec": "~/.config/waybar/scripts/waybar-wttr.py",
    "return-type": "json"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 5,
    "on-click": ""
  },
  "clock": {
    "format": " {:%T  %a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 1
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "min-length": 6
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " Muted",
    "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"volume\")'",
    //"on-click": "~/.config/waybar/scripts/toggle-pulseaudio.sh",
    "escape": true,
    "on-scroll-up": "swayosd-client --output-volume 1",
    "on-scroll-down": "swayosd-client --output-volume -1",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "swayosd-client --input-volume mute-toggle",
    "on-scroll-up": "swayosd-client --input-volume 1",
    "on-scroll-down": "swayosd-client --input-volume -1",
    "scroll-step": 5
  },
  "temperature": {
    "thermal-zone": 1,
    "format": "{temperatureC}°C ",
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C "
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format": "{essid} - {ifname} via {gwaddr}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}:{essid} {ipaddr}/{cidr}"
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": " {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  }
}
